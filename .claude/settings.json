{
  "permissions": {
    "allow": [
      "Bash(./scripts/rapid:*)",
      "Bash(head:*)",
      "Bash(grep:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(ls:*)",
      "Bash(sort:*)",
      "Bash(find:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/hooks/block-rapid-env.sh"
          }
        ]
      }
    ]
  }
}
